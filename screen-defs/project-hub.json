{
  "screen_id": "project-hub",
  "route": "/research/project/hub",
  "title": "プロジェクトハブ",
  "layout": "standard",
  "notes": "PPR-16 — projectHub 投影(project + content/citation/version 集約)。source_path=GET /api/v1/research/projects/{id}(protected)。論文へ id を引き継ぐ。g89-w2research是正: 旧版は `data.project.title`/`data.project.best_version`/`data.project.timeline`/`data.project.lots` 等、GET .../projects/:id のレスポンス実形(ProjectHub={project,contents,citations,versions,individuals,clutches,votes})に存在しないパスを参照していた(catalog score35/100の原因=contents/citations未描画)。実形に合わせて `data.project.project.*` へ補正し、hub直下のcontents/citations/versionsを描画、best_versionは別エンドポイント(GET .../best-version)を別カードで取得する形に是正。timelineはAPI自体に存在しないため実装していない(再現できない要素・§4参照)。",
  "nodes": [
    {
      "id": "shell",
      "type": "app-shell",
      "props": { "page_info": { "purpose": "研究プロジェクトの全体像(論文・ブログ・引用・課題・バージョン)をまとめて見る画面。", "talk_channel": true } },
      "children": [
        {
          "id": "page",
          "type": "page",
          "children": [
            { "id": "title", "type": "heading", "props": { "text": "プロジェクトハブ", "level": 1 } },
            { "id": "project-id", "type": "text", "props": { "text": "プロジェクト ID: {{params.id}}", "muted": true } },
            {
              "id": "project",
              "type": "card",
              "props": { "source_path": "/api/v1/research/projects/{{params.id}}" },
              "children": [
                { "id": "project-title", "type": "heading", "props": { "text": "{{data.project.project.title}}", "level": 2 } },

                { "id": "contents-title", "type": "heading", "props": { "text": "紐づく記事・論文", "level": 3 } },
                {
                  "id": "contents-table",
                  "type": "table",
                  "props": {
                    "bind_items": "data.project.contents",
                    "empty_text": "紐づく記事・論文はまだありません",
                    "columns": [
                      { "key": "content_type", "label": "種別", "cell": "badge" },
                      { "key": "title", "label": "タイトル" },
                      { "key": "content_id", "cell": "link", "href_tpl": "/s/paper-detail?id={{content_id}}", "link_label": "開く" }
                    ]
                  }
                },

                { "id": "citations-title", "type": "heading", "props": { "text": "引用", "level": 3 } },
                {
                  "id": "citations-list",
                  "type": "list",
                  "props": { "bind_items": "data.project.citations", "item_text": "{{content_id}}(提供元 {{provider_actor_id}}・{{contribution_points}}pt・{{status}})", "empty_text": "引用はまだありません" }
                },

                { "id": "versions-title", "type": "heading", "props": { "text": "バージョン分岐", "level": 3 } },
                { "id": "versions", "type": "list", "props": { "bind_items": "data.project.versions", "item_text": "{{title}}(親: {{parent_version_label}})", "empty_text": "分岐はまだありません" } },

                { "id": "lots-title", "type": "heading", "props": { "text": "ロット", "level": 3 } },
                { "id": "lots", "type": "list", "props": { "bind_items": "data.project.project.lots", "item_text": "{{lot_id}}", "empty_text": "ロットはまだありません" } }
              ]
            },
            { "id": "lot-qr", "type": "qr-code", "props": { "when": { "not_empty": "{{data.project.project.lots.0.qr_url}}" }, "value": "{{data.project.project.lots.0.qr_url}}" } },

            {
              "id": "best",
              "type": "card",
              "props": { "source_path": "/api/v1/research/projects/{{params.id}}/best-version" },
              "children": [
                { "id": "best-title", "type": "heading", "props": { "text": "最良バージョン", "level": 3 } },
                {
                  "id": "best-text",
                  "type": "text",
                  "props": { "when": { "not_empty": "{{data.best.best_version.version_label}}" }, "text": "{{data.best.best_version.version_label}}(観測平均スコア {{data.best.best_version.score}}・観測 {{data.best.best_version.observation_count}} 件)" }
                },
                {
                  "id": "best-empty",
                  "type": "text",
                  "props": { "when": { "empty": "{{data.best.best_version.version_label}}" }, "text": "まだ観測データが無いため、最良バージョンは選定されていません。", "muted": true }
                }
              ]
            },

            {
              "id": "to-paper",
              "type": "button",
              "props": { "label": "論文の詳細を見る", "variant": "secondary" },
              "action": { "kind": "navigate", "to": "paper-detail" }
            }
          ]
        }
      ]
    }
  ]
}
